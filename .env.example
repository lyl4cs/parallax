# Never commit real values.

# ==== Worker (worker/, runs on Railway / Fly.io)
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=Parallax
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
# TRADOVATE_DEVICE_ID=
PARALLAX_DRY_RUN=1          # log what would be copied; set to 0 only after a clean dry run
PARALLAX_SWEEP_SECONDS=15

# ==== Dashboard (dashboard/, its own Vercel project)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=          # public by design; RLS protects the data
SUPABASE_SERVICE_ROLE_KEY=  # server-only, used by /api/rules after ownership checks

# ==== Waitlist landing page (repo root, existing Vercel project)
USE_DEMO=true
MOCK_MODE=true
PORT=3001

# Email (waitlist confirmations and notifications). Set EMAIL_ENABLED=true to enable.
EMAIL_ENABLED=false
EMAIL_SERVICE=smtp          # 'smtp' or 'sendgrid'
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Parallax Team
