# ---- Worker (Railway / Fly.io). Never commit real values.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=Parallax
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
# TRADOVATE_DEVICE_ID=
PARALLAX_DRY_RUN=1          # log what would be copied; set to 0 only after a clean dry run
PARALLAX_SWEEP_SECONDS=15

# ---- Vercel (dashboard + /api)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=          # public by design; RLS protects the data
SUPABASE_SERVICE_ROLE_KEY=  # server-only, used by /api/rules after ownership checks
